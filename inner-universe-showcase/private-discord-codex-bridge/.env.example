# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Optional fallback OpenAI API key from https://platform.openai.com/api-keys.
# Courier mode does not require this when CODEX_HANDLE_ALL_MESSAGES=true.
OPENAI_API_KEY=

# Your Discord user id. Required. Comma-separate if you want to allow more than one account.
ALLOWED_USER_IDS=

# Private Discord channel ids where the bot may answer.
# Leave empty to ignore all server channels and allow only DMs if ALLOW_DMS=true.
ALLOWED_CHANNEL_IDS=

# Let the allowed user DM the bot directly.
ALLOW_DMS=true

# Used only when CODEX_HANDLE_ALL_MESSAGES=false and a message does not start with CODEX_TRIGGER.
# If OpenAI returns insufficient_quota, OpenAI fallback is paused for this bot run.
OPENAI_MODEL=gpt-5.5
OPENAI_STREAMING=true
OPENAI_STREAM_EDIT_INTERVAL_MS=1200
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_FALLBACK_TO_CODEX=true

# How many user/assistant messages to keep in memory per channel. Nothing is written to disk.
MAX_HISTORY_MESSAGES=8

# Basic anti-spam cooldown per allowed user. Use 0 for courier mode.
COOLDOWN_MS=0

# Log message metadata and ignore reasons, but never message content.
DEBUG_SAFE_LOG=true

# Local Codex bridge. By default, only messages starting with CODEX_TRIGGER are sent to local Codex.
CODEX_ENABLED=true
CODEX_TRIGGER=!codex
CODEX_COMMAND=C:\Users\User\AppData\Roaming\npm\codex.cmd
CODEX_MODEL=gpt-5.5
CODEX_WORKDIR=C:\Users\User\Documents\New project 4
CODEX_SANDBOX=danger-full-access
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_CHARS=6000
CODEX_HANDLE_ALL_MESSAGES=true
CODEX_TRIGGER_ONLY=false
CODEX_SESSION_MODE=per-channel
CODEX_SESSION_STORE=C:\Users\User\Documents\New project 4\discord-private-ai-bot\state\codex-sessions.json
CODEX_RESET_COMMAND=重置脈絡

# Local file attachments. These are only for approved users/channels.
# Use: 傳檔 雷-設定圖.png
FILE_SEND_ENABLED=true
FILE_SEND_COMMANDS=傳檔,送檔,附件,file,attach
FILE_SEND_ALLOWED_ROOTS=C:\Users\User\Documents\New project 4
FILE_SEND_MAX_BYTES=8388608
FILE_SEND_ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.pdf,.txt,.md,.csv,.docx,.xlsx,.pptx,.zip

# Discord attachment downloads from approved users/channels.
# Downloaded files must stay under CODEX_WORKDIR.
FILE_RECEIVE_ENABLED=true
FILE_RECEIVE_DIR=C:\Users\User\Documents\New project 4\discord-downloads
FILE_RECEIVE_MAX_BYTES=52428800
FILE_RECEIVE_MAX_FILES=5
FILE_RECEIVE_TIMEOUT_MS=30000
FILE_RECEIVE_ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp,.gif,.pdf,.txt,.md,.csv,.docx,.xlsx,.pptx,.zip,.json,.mp3,.wav,.m4a,.mp4,.mov

# Local transcript for Discord requests and Codex results.
TRANSCRIPT_ENABLED=true
TRANSCRIPT_PATH=C:\Users\User\Documents\New project 4\discord-private-ai-bot\transcripts\discord-codex.md
TRANSCRIPT_MAX_CHARS=200000
TRANSCRIPT_DELETE_COMMAND=刪除記憶檔
TRANSCRIPT_INCLUDE_USAGE=true

# Optional: customize the assistant personality.
BOT_INSTRUCTIONS=You are a helpful private Discord assistant. Reply in the same language as the user unless asked otherwise. Keep answers concise and practical.
